generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum ClientStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum TimelineEventType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  STATUS_CHANGE
  NOTE
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
  PROPERTIES_SHARED
  INTERESTED
  SITE_VISIT
  BOOKING
  CLOSED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  OTHER
}

enum SiteVisitStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}


enum DocumentType {
  BROCHURE
  PAYMENT_PLAN
  RERA
  REGISTRY
  INVOICE
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InventoryUpdateSource {
  AGENT
  BUILDER
}


enum FeedbackSentiment {
  INTERESTED
  MAYBE
  NOT_INTERESTED
}

enum ClientActivityType {
  PORTAL_OPENED
  PROPERTY_VIEWED
  PROPERTY_FAVORITED
  PROPERTY_UNFAVORITED
  FEEDBACK_GIVEN
  COMMENT_ADDED
  SITE_VISIT_REQUESTED
  SITE_VISIT_CONFIRMED
  CONTACT_AGENT
  CALL_AGENT
  WHATSAPP_AGENT
}

enum RequirementFurnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum RequirementPurpose {
  BUY
  RENT
  INVESTMENT
}

enum RequirementUrgency {
  LOW
  MEDIUM
  HIGH
}

enum CommunicationType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  MEETING
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum OfferParty {
  BUYER
  SELLER
}

enum OfferStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum DealStage {
  BOOKING
  AGREEMENT
  LOAN
  REGISTRATION
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  LOAN_DISBURSEMENT
  OTHER
}

enum CommissionStatus {
  PENDING
  RECEIVED
  PAID_OUT
  CANCELLED
}




model User {
  id                String            @id @default(uuid())
  fullName          String
  email             String            @unique
  password          String
  phone             String?
  role              Role              @default(AGENT)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  refreshTokens     RefreshToken[]
  properties        Property[]
  clients           Client[]
  clientNotes       ClientNote[]
  clientTimelines   ClientTimeline[]
  sharedProperties  SharedProperty[]
  createdLeads      Lead[]            @relation("LeadCreator")
  assignedLeads     Lead[]            @relation("LeadAssignee")
  leadActivities    LeadActivity[]
  createdTasks      Task[]            @relation("TaskCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  assignedSiteVisits SiteVisit[]      @relation("SiteVisitAssignee")
  createdSiteVisits  SiteVisit[]      @relation("SiteVisitCreator")
  inventoryChanges InventoryStatusLog[]
  notifications      Notification[]
  savedViews         SavedView[]
  communications     CommunicationLog[]
  uploadedDocuments Document[]
  createdInvoices   Invoice[]
  createdCollections PropertyCollection[]
    createdOwners      Owner[]
  createdOffers      Offer[]
  agentDeals         Deal[]         @relation("DealAgent")
  createdDeals       Deal[]         @relation("DealCreator")
  createdPayments    Payment[]
  agentCommissions   Commission[]   @relation("CommissionAgent")
  createdCommissions Commission[]   @relation("CommissionCreator")
  uploadedDealDocuments DealDocument[]
  

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Property {
  id           String            @id @default(uuid())
  title        String
  description  String?
  propertyType PropertyType
  status       PropertyStatus    @default(AVAILABLE)
  price        Float
  areaSqft     Float?
  bedrooms     Int?
  bathrooms    Int?
  address      String
  city         String
  state        String
  latitude     Float?
  longitude    Float?
  projectId    String?
  project      Project?              @relation(fields: [projectId], references: [id])
  statusLogs   InventoryStatusLog[]
  aiSummary    PropertyAiSummary?
  amenities              String[]  @default([])
  estimatedRentalMonthly Float?
  maintenanceMonthly     Float?
  annualAppreciationPercent Float?
  possessionDate         DateTime?
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  favorites    Favorite[]
  sharedWith   SharedProperty[]
  leads        Lead[]
  siteVisits   SiteVisit[]
  documents    Document[]
  invoices     Invoice[]
  nearbyPlaces PropertyNearbyPlace[]
  feedback   PropertyFeedback[]
  comments   PropertyComment[]
  activities ClientActivity[]
    ownerId    String?
  owner      Owner?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  offers     Offer[]
  deals      Deal[]

  @@map("properties")
}

model Builder {
  id                String    @id @default(uuid())
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  commissionPercent Float
  address           String?
  notes             String?
  projects          Project[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("builders")
}

model Project {
  id             String        @id @default(uuid())
  builderId      String
  builder        Builder       @relation(fields: [builderId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  city           String
  state          String
  status         ProjectStatus @default(UPCOMING)
  properties Property[]
  launchDate     DateTime?
  possessionDate DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("projects")
}

model Client {
  id                String              @id @default(uuid())
  fullName          String
  phone             String
  email             String?
  source            String?
  status            ClientStatus        @default(NEW)
  portalToken String? @unique
  portalTokenExpiresAt DateTime?
  portalTokenRevokedAt DateTime?
  createdById       String
  createdBy         User                @relation(fields: [createdById], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  requirements      ClientRequirement[]
  notes             ClientNote[]
  timeline          ClientTimeline[]
  favorites         Favorite[]
  sharedProperties  SharedProperty[]
  leads             Lead[]
  siteVisits        SiteVisit[]
  invoices          Invoice[]
  collections      PropertyCollection[]
  activities       ClientActivity[]
  communications   CommunicationLog[]
  propertyFeedback PropertyFeedback[]
  propertyComments PropertyComment[]
    offers           Offer[]
  deals            Deal[]

  @@map("clients")
}

model ClientRequirement {
  id                 String                 @id @default(uuid())
  clientId           String
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyType       PropertyType
  preferredCity      String
  minBudget          Float?
  maxBudget          Float?
  bedrooms           Int?
  minArea            Float?
  maxArea            Float?
  furnishing         RequirementFurnishing?
  parking            Boolean?
  facing             String?
  floorPreference    String?
  possessionBy       DateTime?
  purpose            RequirementPurpose?
  financing          String?
  urgency            RequirementUrgency?
  preferredLocations String[]               @default([])
  notes              String?
  createdAt          DateTime               @default(now())

  @@map("client_requirements")
}

model ClientNote {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("client_notes")
}

model ClientTimeline {
  id          String            @id @default(uuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventType   TimelineEventType
  description String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@map("client_timeline")
}

model Favorite {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([clientId, propertyId])
  @@map("favorites")
}

model SharedProperty {
  id           String              @id @default(uuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sharedById   String
  sharedBy     User                @relation(fields: [sharedById], references: [id])
  collectionId String?
  collection   PropertyCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  position     Int?
  sharedAt     DateTime            @default(now())

  @@map("shared_properties")
}

model LeadSource {
  id        String   @id @default(uuid())
  name      String   @unique
  leads     Lead[]
  createdAt DateTime @default(now())

  @@map("lead_sources")
}

model Lead {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId    String?
  property      Property?      @relation(fields: [propertyId], references: [id])
  leadSourceId  String?
  leadSource    LeadSource?    @relation(fields: [leadSourceId], references: [id])
  assignedToId  String
  assignedTo    User           @relation("LeadAssignee", fields: [assignedToId], references: [id])
  stage         LeadStage      @default(NEW)
  createdById   String
  createdBy     User           @relation("LeadCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activities    LeadActivity[]
  tasks         Task[]
  communications CommunicationLog[]
    offers        Offer[]
  deal          Deal?

  @@map("leads")
}

model LeadActivity {
  id           String       @id @default(uuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType ActivityType
  description  String
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())

  @@map("lead_activities")
}

model Task {
  id           String    @id @default(uuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime?
  isCompleted  Boolean   @default(false)
  assignedToId String
  assignedTo   User      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("tasks")
}

model SiteVisit {
  id               String          @id @default(uuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id])
  assignedToId     String
  assignedTo       User            @relation("SiteVisitAssignee", fields: [assignedToId], references: [id])
  scheduledAt      DateTime
  status           SiteVisitStatus @default(SCHEDULED)
  clientConfirmed  Boolean         @default(false)
  builderConfirmed Boolean         @default(false)
  notes            String?
  createdById      String
  createdBy        User            @relation("SiteVisitCreator", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("site_visits")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
    type      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Document {
  id           String       @id @default(uuid())
  title        String
  docType      DocumentType
  fileUrl      String
  publicId     String
  fileType     String
  fileSize     Int
  propertyId   String
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@map("documents")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  propertyId    String?
  property      Property?     @relation(fields: [propertyId], references: [id])
  amount        Float
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  notes         String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("invoices")
}

model PropertyNearbyPlace {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  placeType  String
  name       String
  distanceKm Float
  createdAt  DateTime @default(now())

  @@map("property_nearby_places")
}

model InventoryStatusLog {
  id             String                 @id @default(uuid())
  propertyId     String
  property       Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  previousStatus PropertyStatus
  newStatus      PropertyStatus
  source         InventoryUpdateSource  @default(AGENT)
  note           String?
  changedById    String
  changedBy      User                   @relation(fields: [changedById], references: [id])
  createdAt      DateTime               @default(now())

  @@map("inventory_status_logs")
}

model PropertyAiSummary {
  id               String   @id @default(uuid())
  propertyId       String   @unique
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  summary          String
  pros             String[] @default([])
  cons             String[] @default([])
  investmentScore  Int?
  investmentNote   String?
  model            String
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("property_ai_summaries")
}

model PropertyCollection {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  accessToken String    @unique
  expiresAt   DateTime?
  revokedAt   DateTime?
  isArchived  Boolean   @default(false)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sharedProperties SharedProperty[]
  activities       ClientActivity[]
  feedback         PropertyFeedback[]
  comments         PropertyComment[]

  @@map("property_collections")
}

model PropertyFeedback {
  id           String              @id @default(uuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   PropertyCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  sentiment    FeedbackSentiment
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([clientId, propertyId])
  @@map("property_feedback")
}

model PropertyComment {
  id           String              @id @default(uuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   PropertyCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime            @default(now())

  @@map("property_comments")
}

model ClientActivity {
  id           String              @id @default(uuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   PropertyCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  propertyId   String?
  property     Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  type         ClientActivityType
  metadata     Json?
  createdAt    DateTime            @default(now())

  @@index([clientId, createdAt])
  @@map("client_activities")
}

model SavedView {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  entity    String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entity])
  @@map("saved_views")
}


model CommunicationLog {
  id          String                 @id @default(uuid())
  clientId    String
  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  type        CommunicationType
  direction   CommunicationDirection
  body        String
  occurredAt  DateTime               @default(now())
  createdById String
  createdBy   User                   @relation(fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())

  @@index([clientId, occurredAt])
  @@map("communication_logs")
}



model Owner {
  id          String     @id @default(uuid())
  fullName    String
  phone       String
  email       String?
  address     String?
  notes       String?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
  deals       Deal[]

  @@map("owners")
}

model Offer {
  id          String      @id @default(uuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  party       OfferParty
  amount      Float
  status      OfferStatus @default(PROPOSED)
  note        String?
  validUntil  DateTime?
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([leadId, createdAt])
  @@map("offers")
}

model Deal {
  id               String    @id @default(uuid())
  leadId           String    @unique
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ownerId          String?
  owner            Owner?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  agentId          String
  agent            User      @relation("DealAgent", fields: [agentId], references: [id])
  stage            DealStage @default(BOOKING)
  dealValue        Float
  bookingDate      DateTime  @default(now())
  agreementDate    DateTime?
  loanApprovalDate DateTime?
  registrationDate DateTime?
  completedDate    DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  notes            String?
  createdById      String
  createdBy        User      @relation("DealCreator", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  offers     Offer[]
  payments   Payment[]
  commission Commission?
  documents  DealDocument[]

  @@map("deals")
}

model Payment {
  id          String         @id @default(uuid())
  dealId      String
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label       String?
  amount      Float
  dueDate     DateTime?
  paidAt      DateTime?
  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  reference   String?
  note        String?
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([dealId, dueDate])
  @@map("payments")
}

model Commission {
  id            String           @id @default(uuid())
  dealId        String           @unique
  deal          Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  grossAmount   Float
  agentPercent  Float
  agentAmount   Float
  companyAmount Float
  status        CommissionStatus @default(PENDING)
  receivedAt    DateTime?
  paidOutAt     DateTime?
  agentId       String
  agent         User             @relation("CommissionAgent", fields: [agentId], references: [id])
  note          String?
  createdById   String
  createdBy     User             @relation("CommissionCreator", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("deal_commissions")
}

model DealDocument {
  id           String       @id @default(uuid())
  dealId       String
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title        String
  docType      DocumentType
  fileUrl      String
  publicId     String
  fileType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@map("deal_documents")
}