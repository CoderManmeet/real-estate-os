generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum ClientStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum TimelineEventType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  STATUS_CHANGE
  NOTE
  OTHER
}

model User {
  id                String            @id @default(uuid())
  fullName          String
  email             String            @unique
  password          String
  role              Role              @default(AGENT)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  refreshTokens     RefreshToken[]
  properties        Property[]
  clients           Client[]
  clientNotes       ClientNote[]
  clientTimelines   ClientTimeline[]
  sharedProperties  SharedProperty[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Property {
  id           String            @id @default(uuid())
  title        String
  description  String?
  propertyType PropertyType
  status       PropertyStatus    @default(AVAILABLE)
  price        Float
  areaSqft     Float?
  bedrooms     Int?
  bathrooms    Int?
  address      String
  city         String
  state        String
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  favorites    Favorite[]
  sharedWith   SharedProperty[]

  @@map("properties")
}

model Builder {
  id                String    @id @default(uuid())
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  commissionPercent Float
  address           String?
  notes             String?
  projects          Project[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("builders")
}

model Project {
  id             String        @id @default(uuid())
  builderId      String
  builder        Builder       @relation(fields: [builderId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  city           String
  state          String
  status         ProjectStatus @default(UPCOMING)
  launchDate     DateTime?
  possessionDate DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("projects")
}

model Client {
  id                String             @id @default(uuid())
  fullName          String
  phone             String
  email             String?
  source            String?
  status            ClientStatus       @default(NEW)
  createdById       String
  createdBy         User               @relation(fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  requirements      ClientRequirement[]
  notes             ClientNote[]
  timeline          ClientTimeline[]
  favorites         Favorite[]
  sharedProperties  SharedProperty[]

  @@map("clients")
}

model ClientRequirement {
  id            String       @id @default(uuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyType  PropertyType
  preferredCity String
  minBudget     Float?
  maxBudget     Float?
  bedrooms      Int?
  notes         String?
  createdAt     DateTime     @default(now())

  @@map("client_requirements")
}

model ClientNote {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("client_notes")
}

model ClientTimeline {
  id          String            @id @default(uuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventType   TimelineEventType
  description String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@map("client_timeline")
}

model Favorite {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([clientId, propertyId])
  @@map("favorites")
}

model SharedProperty {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sharedById  String
  sharedBy    User     @relation(fields: [sharedById], references: [id])
  sharedAt    DateTime @default(now())

  @@map("shared_properties")
}